enum NotificationType {
  EARLY_NOTICE_PENDING
  EARLY_NOTICE_CONFIRMED
  EARLY_NOTICE_REJECTED
  EARLY_NOTICE_UPDATED
  EARLY_NOTICE_CANCELLED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_CANCELLED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model Notification {
  id Int @id @default(autoincrement())
  type NotificationType
  title String
  message String @db.Text
  isRead Boolean @default(false)
  readAt DateTime?
  createdAt DateTime @default(now())
  userId Int
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  // Avisos y eventos son orígenes alternativos; el servicio exige exactamente uno.
  earlyNoticeId Int?
  earlyNotice EarlyNotice? @relation("EarlyNoticeNotifications", fields: [earlyNoticeId], references: [id], onDelete: Cascade)
  institutionEventId Int?
  institutionEvent InstitutionEvent? @relation("InstitutionEventNotifications", fields: [institutionEventId], references: [id], onDelete: Cascade)
  // Cada modificación confirmada genera una versión distinta por destinatario.
  revision Int @default(1)
  deliveries NotificationDelivery[]

  @@unique([userId, earlyNoticeId, type, revision])
  @@unique([userId, institutionEventId, type, revision])
  @@index([userId, isRead, createdAt])
  @@index([earlyNoticeId])
  @@index([institutionEventId])
}

model NotificationDelivery {
  id Int @id @default(autoincrement())
  channel NotificationChannel
  status NotificationDeliveryStatus @default(PENDING)
  recipient String
  providerMessageId String?
  attempts Int @default(0)
  lastError String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sentAt DateTime?
  deliveredAt DateTime?
  notificationId Int
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@index([providerMessageId])
}
model UserDevice {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   @default("flutter_android")// "flutter_android", "flutter_web", "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
