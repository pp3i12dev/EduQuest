enum InvitedRole {
  DIRECTOR
  PRECEPTOR
  TEACHER
  STUDENT
}

model Invitation {
  id        Int         @id @default(autoincrement())
  email     String
  role      InvitedRole
  token     String      @unique @default(uuid())
  isUsed    Boolean     @default(false)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  invitedById Int
  invitedBy   User @relation("SentInvitations", fields: [invitedById], references: [id])

  // Solo se completa cuando el que invita es un docente invitando a un
  // alumno: fija a qué curso queda matriculado el alumno al aceptar.
  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])
}