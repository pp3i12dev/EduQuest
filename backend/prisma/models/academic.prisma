enum EducationLevel {
  JARDIN
  PRIMARIO
  SECUNDARIO
  TECNICATURA_SUPERIOR
  UNIVERSITARIO
  POSTGRADO
  CURSO
  OTRO
}

enum ScheduleDay {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

enum Shift {
  MANANA
  TARDE
  NOCHE
}

// Modalidad de cada encuentro: compatible con clases presenciales o a distancia.
enum ClassModality {
  PRESENCIAL
  VIRTUAL_SINCRONA
  VIRTUAL_ASINCRONA
}

model Career {
  id Int @id @default(autoincrement())
  nombre String
  level EducationLevel
  createdAt DateTime @default(now())
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  courses Course[]
  institutionEvents InstitutionEventCareer[]
}

model Course {
  id Int @id @default(autoincrement())
  nombre String
  academicYear Int @default(2026)
  // Turno de pertenencia del curso. Nullable únicamente para no alterar cursos antiguos;
  // las altas nuevas deben enviarlo obligatoriamente.
  shift Shift?
  createdAt DateTime @default(now())
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  careerId Int?
  career Career? @relation(fields: [careerId], references: [id])
  ActivityCourse ActivityCourse[]
  students StudentCourse[]
  teachers TeacherSubject[]
  schedules SubjectSchedule[]
  invitations Invitation[]
  earlyNotices EarlyNotice[]
  institutionEvents InstitutionEventCourse[]
  @@index([institutionId, careerId, academicYear, shift])
}

model Subject {
  id Int @id @default(autoincrement())
  nombre String
  createdAt DateTime @default(now())
  isActive Boolean @default(true)
  // Archivo administrativo: ocultar la materia sin borrar actas ni intentos.
  deletedAt DateTime?
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  teachers TeacherSubject[]
  schedules SubjectSchedule[]
  earlyNotices EarlyNotice[]
  @@index([deletedAt])
}

model TeacherSubject {
  id Int @id @default(autoincrement())
  teacherId Int
  teacher TeacherProfile @relation(fields: [teacherId], references: [id])
  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id])
  courseId Int
  course Course @relation(fields: [courseId], references: [id])
  isActive Boolean @default(true)
  activities Activity[]
  contents TeacherSubjectContent[]
  units Unit[]
  studyMaterials StudyMaterial[]
  earlyNotices EarlyNotice[]
  affectedNoticeClasses EarlyNoticeClass[]
  @@unique([teacherId, subjectId, courseId])
  @@index([subjectId, courseId, isActive])
}

model StudentCourse {
  id Int @id @default(autoincrement())
  studentId Int @unique
  student StudentProfile @relation(fields: [studentId], references: [id])
  courseId Int
  course Course @relation(fields: [courseId], references: [id])
  @@unique([studentId, courseId])
}

model SubjectSchedule {
  id Int @id @default(autoincrement())
  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseId Int
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  day ScheduleDay
  shift Shift
  modality ClassModality @default(PRESENCIAL)
  startTime String
  endTime String
  createdAt DateTime @default(now())
  earlyNotices EarlyNotice[]
  affectedNoticeClasses EarlyNoticeClass[]
  @@index([courseId, subjectId])
  @@index([courseId, day])
}
