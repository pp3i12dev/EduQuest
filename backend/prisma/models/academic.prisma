enum EducationLevel {
  JARDIN
  PRIMARIO
  SECUNDARIO
  TERCIARIO
  UNIVERSITARIO
  POSTGRADO
  CURSO
  OTRO
}

enum ScheduleDay {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

enum Shift {
  MANANA
  TARDE
  NOCHE
}

model Career {
  id Int @id @default(autoincrement())
  nombre String
  level EducationLevel
  createdAt DateTime @default(now())
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  courses Course[]
  institutionEvents InstitutionEventCareer[]
}

model Course {
  id Int @id @default(autoincrement())
  nombre String
  academicYear Int @default(2026)
  createdAt DateTime @default(now())
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  careerId Int?
  career Career? @relation(fields: [careerId], references: [id])
  students StudentCourse[]
  teachers TeacherSubject[]
  schedules SubjectSchedule[]
  invitations Invitation[]
  earlyNotices EarlyNotice[]
  institutionEvents InstitutionEventCourse[]
}

model Subject {
  id Int @id @default(autoincrement())
  nombre String
  createdAt DateTime @default(now())
  isActive Boolean @default(true)
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  teachers TeacherSubject[]
  schedules SubjectSchedule[]
  earlyNotices EarlyNotice[]
}

model TeacherSubject {
  id Int @id @default(autoincrement())
  teacherId Int
  teacher TeacherProfile @relation(fields: [teacherId], references: [id])
  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id])
  courseId Int
  course Course @relation(fields: [courseId], references: [id])
  isActive Boolean @default(true)
  activities Activity[]
  contents TeacherSubjectContent[]
  units Unit[]
  earlyNotices EarlyNotice[]
  affectedNoticeClasses EarlyNoticeClass[]
  @@unique([teacherId, subjectId, courseId])
  @@index([subjectId, courseId, isActive])
}

model StudentCourse {
  id Int @id @default(autoincrement())
  studentId Int
  student StudentProfile @relation(fields: [studentId], references: [id])
  courseId Int
  course Course @relation(fields: [courseId], references: [id])
  @@unique([studentId, courseId])
}

model SubjectSchedule {
  id Int @id @default(autoincrement())
  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseId Int
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  day ScheduleDay
  shift Shift
  startTime String
  endTime String
  createdAt DateTime @default(now())
  earlyNotices EarlyNotice[]
  affectedNoticeClasses EarlyNoticeClass[]
  @@index([courseId, subjectId])
  @@index([courseId, day])
}
