enum EarlyNoticeType {
  ABSENCE
  LATE_ARRIVAL
  ATTENDANCE_CONFIRMED
  VIRTUAL_SYNCHRONOUS
  VIRTUAL_ASYNCHRONOUS
}

enum EarlyNoticeStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model EarlyNotice {
  id        Int               @id @default(autoincrement())
  type      EarlyNoticeType
  status    EarlyNoticeStatus @default(PENDING)
  // Campos originales preservados para compatibilidad con los servicios existentes.
  classDate DateTime @db.Date
  estimatedArrivalTime String?
  reason          String    @db.Text
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  // Ampliación: período, clase virtual, archivado y eliminación lógica.
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  virtualMeetingUrl String?
  virtualInstructions String? @db.Text
  archivedAt DateTime?
  deletedAt DateTime?

  institutionId Int
  institution   Institution @relation(fields: [institutionId], references: [id])
  teacherSubjectId Int
  teacherSubject   TeacherSubject @relation(fields: [teacherSubjectId], references: [id])
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])
  scheduleId Int?
  schedule   SubjectSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  day       ScheduleDay
  shift     Shift
  startTime String
  endTime   String
  teacherUserId Int
  teacherUser   User @relation("EarlyNoticeTeacher", fields: [teacherUserId], references: [id])
  createdById Int
  createdBy   User @relation("EarlyNoticeCreator", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("EarlyNoticeUpdater", fields: [updatedById], references: [id])
  confirmedById Int?
  confirmedBy   User? @relation("EarlyNoticeConfirmer", fields: [confirmedById], references: [id])
  notifications Notification[] @relation("EarlyNoticeNotifications")
  affectedClasses EarlyNoticeClass[]
  revisions EarlyNoticeRevision[]

  @@index([institutionId, classDate, status])
  @@index([teacherUserId, status])
  @@index([courseId, classDate])
  @@index([institutionId, deletedAt])
}
