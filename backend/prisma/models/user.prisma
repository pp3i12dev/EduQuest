model User {
  id Int @id @default(autoincrement())
  dni String @unique
  email String @unique
  telefono String?
  passwordHash String
  firstName String
  lastName String
  isActive Boolean @default(true)
  isSuperAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionId Int?
  institution Institution? @relation(fields: [institutionId], references: [id])
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  preceptorProfile PreceptorProfile?
  directorProfile DirectorProfile?
  refreshTokens RefreshToken[]
  sentInvitations Invitation[] @relation("SentInvitations")
  passwordResetTokens PasswordResetToken[]
  createdEarlyNotices EarlyNotice[] @relation("EarlyNoticeCreator")
  updatedEarlyNotices EarlyNotice[] @relation("EarlyNoticeUpdater")
  responsibleEarlyNotices EarlyNotice[] @relation("EarlyNoticeTeacher")
  confirmedEarlyNotices EarlyNotice[] @relation("EarlyNoticeConfirmer")
  notifications Notification[] @relation("UserNotifications")
  earlyNoticeRevisions EarlyNoticeRevision[] @relation("EarlyNoticeRevisionAuthor")
  createdInstitutionEvents InstitutionEvent[] @relation("InstitutionEventCreator")
  updatedInstitutionEvents InstitutionEvent[] @relation("InstitutionEventUpdater")
  institutionEventRevisions InstitutionEventRevision[] @relation("InstitutionEventRevisionAuthor")
}

model PasswordResetToken {
  id Int @id @default(autoincrement())
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
