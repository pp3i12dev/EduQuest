<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../../USS/EduQuest.uss" />
  <ui:VisualElement class="screen eq-theme forgot-screen auth-screen">
    <ui:ScrollView class="page-scroll eq-scroll">
      <ui:VisualElement class="container auth-layout auth-card-layout recovery-layout">
        <ui:Button name="back" text="‹" class="back-square" />
        <ui:VisualElement class="recovery-envelope art-mail" />
        <ui:Label text="Recuperar contraseña" class="heading title-centered" />
        <ui:Label text="Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña." class="subheading title-centered recovery-description" />
        <ui:VisualElement class="auth-fields exact-auth-block">
          <ui:VisualElement class="field-shell">
            <ui:VisualElement class="field-icon art-icon-mail" />
            <ui:TextField name="email" label="" class="field auth-field field-inline" />
          </ui:VisualElement>
          <ui:Button name="send" text="Enviar enlace" class="primary auth-submit" />
        </ui:VisualElement>
        <ui:VisualElement class="recovery-note-box">
          <ui:VisualElement class="note-icon art-icon-info" />
          <ui:Label name="recovery-note" class="recovery-note" text="Revisa también tu carpeta de correo no deseado (spam)." />
        </ui:VisualElement>
        <ui:Label name="status" class="status title-centered" />
      </ui:VisualElement>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
