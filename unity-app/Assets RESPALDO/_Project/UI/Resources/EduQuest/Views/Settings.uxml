<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../../USS/EduQuest.uss" />
  <ui:VisualElement class="screen eq-theme generic-screen settings-screen">
    <ui:VisualElement class="layout">
      <ui:ScrollView class="main-scroll eq-scroll">
        <ui:VisualElement class="content generic-content">
          <ui:VisualElement class="home-topbar">
            <ui:Button name="settings-back-top" text="← Volver" class="settings-back-top" />
            <ui:VisualElement class="logo-group small"><ui:VisualElement class="logo-star art-star" /><ui:VisualElement class="logo-text art-logo" /></ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="white-panel content-panel settings-panel">
            <ui:VisualElement class="settings-heading-row"><ui:VisualElement class="settings-heading-icon art-settings-gear" /><ui:VisualElement class="eq-settings-heading-text"><ui:Label text="Configuración" class="heading" /><ui:Label text="de audio" class="eq-settings-heading-subtitle" /></ui:VisualElement></ui:VisualElement>
            <ui:Label text="Personalizá la música y los efectos de los juegos." class="subheading" />
            <ui:VisualElement name="audio-settings" class="glass eq-audio-settings">
              <ui:Label text="Efectos de sonido" class="question" />
              <ui:Label text="Aciertos, errores, botones y resultados." class="muted" />
              <ui:Button name="audio-toggle" text="Sonidos activados" class="secondary" />
            </ui:VisualElement>
            <ui:Button name="settings-back" text="Volver al inicio" class="primary" />
            <ui:Label name="status" class="status" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:ScrollView>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
