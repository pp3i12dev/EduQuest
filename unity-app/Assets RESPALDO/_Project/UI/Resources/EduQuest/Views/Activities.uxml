<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../../USS/EduQuest.uss" />
<ui:VisualElement class="screen eq-theme generic-screen generic-activities"><ui:VisualElement class="layout"><ui:ScrollView class="main-scroll eq-scroll"><ui:VisualElement class="content generic-content"><ui:VisualElement class="home-topbar"><ui:Button name="home-menu" class="home-menu art-menu" tooltip="Abrir menú" /><ui:VisualElement class="logo-group small"><ui:VisualElement class="logo-star art-star" /><ui:VisualElement class="logo-text art-logo" /></ui:VisualElement><ui:VisualElement class="topbar-stat"><ui:VisualElement class="stat-symbol art-star" /><ui:Label name="top-points" class="top-stat-value" text="—" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="white-panel content-panel"><ui:Label xmlns:ui="UnityEngine.UIElements" text="Contenido de la materia" class="heading"/><ui:Label xmlns:ui="UnityEngine.UIElements" text="Explorá unidades, temas, lecturas y desafíos." class="subheading"/><ui:VisualElement xmlns:ui="UnityEngine.UIElements" class="glass"><ui:Label name="subject-name" class="question"/><ui:VisualElement class="row"><ui:Button name="content" text="Contenidos" class="secondary"/><ui:Button name="pending" text="Pendientes" class="secondary"/><ui:Button name="completed" text="Completadas" class="secondary"/><ui:Button name="back" text="Volver a materias" class="ghost"/></ui:VisualElement></ui:VisualElement><ui:VisualElement xmlns:ui="UnityEngine.UIElements" class="glass"><ui:VisualElement name="items"/></ui:VisualElement><ui:Label xmlns:ui="UnityEngine.UIElements" name="status" class="status"/></ui:VisualElement></ui:VisualElement></ui:ScrollView><ui:VisualElement name="home-menu-layer" class="home-menu-layer"><ui:VisualElement name="menu-backdrop" class="home-menu-backdrop" />
 <ui:VisualElement class="sidebar">
  <ui:VisualElement class="drawer-head"><ui:Button name="close-menu" class="drawer-close" text="X" />
    <ui:VisualElement name="drawer-avatar" class="drawer-avatar art-avatar" />
    <ui:Label name="drawer-name" text="Estudiante" class="drawer-name" />
    <ui:Label name="drawer-level" text="Alumno de EduQuest" class="drawer-level" />
  </ui:VisualElement>
  <ui:Button name="nav-home" class="nav nav-active"><ui:VisualElement class="drawer-nav-icon art-navhome" /><ui:Label text="Inicio" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-practice" class="nav"><ui:VisualElement class="drawer-nav-icon art-navplay" /><ui:Label text="Jugar (Práctica)" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-subjects" class="nav"><ui:VisualElement class="drawer-nav-icon art-navsubjects" /><ui:Label text="Materias" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-history" class="nav"><ui:VisualElement class="drawer-nav-icon art-navhistory" /><ui:Label text="Historial" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-profile" class="nav"><ui:VisualElement class="drawer-nav-icon art-navprofile" /><ui:Label text="Perfil" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-settings" class="nav"><ui:VisualElement class="drawer-nav-icon art-navsettings" /><ui:Label text="Configuración" class="drawer-nav-label" /></ui:Button>
  <ui:VisualElement class="drawer-divider" />
  <ui:VisualElement class="drawer-spacer" />
  <ui:Button name="nav-logout" class="danger logout"><ui:VisualElement class="drawer-nav-icon art-navlogout" /><ui:Label text="Cerrar sesión" class="drawer-nav-label" /></ui:Button>
 </ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement>
</ui:UXML>
