<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../../USS/EduQuest.uss" />
  <ui:VisualElement class="screen eq-theme home-mobile"><ui:VisualElement class="layout">
<ui:ScrollView name="home-scroll" class="main-scroll eq-scroll"><ui:VisualElement class="content home-content">
<ui:VisualElement class="home-topbar"><ui:Button name="home-menu" class="home-menu art-menu" tooltip="Abrir menú" /><ui:VisualElement class="logo-group small"><ui:VisualElement class="logo-star art-star" /><ui:VisualElement class="logo-text art-logo" /></ui:VisualElement>
<ui:VisualElement class="home-top-stats"><ui:VisualElement class="top-stat"><ui:VisualElement class="stat-symbol art-star" /><ui:Label name="points" text="1200" class="top-stat-value" /></ui:VisualElement><ui:VisualElement class="top-stat"><ui:VisualElement class="stat-symbol art-coin" /><ui:Label name="coins" text="340" class="top-stat-value" /></ui:VisualElement></ui:VisualElement></ui:VisualElement>
<ui:VisualElement class="student-card"><ui:VisualElement name="avatar" class="avatar hero-avatar art-avatar" /><ui:VisualElement class="hero-info"><ui:Label name="student-name" text="¡Hola, Estudiante!" class="hero-name" /><ui:Label text="Estudiante" class="hero-role" /><ui:Label name="level" text="Nivel 5" class="level-text" /><ui:VisualElement class="level-track"><ui:VisualElement name="progress-fill" class="level-fill" /></ui:VisualElement></ui:VisualElement></ui:VisualElement>
<ui:VisualElement class="game-tiles"><ui:VisualElement class="tile-row">
<ui:Button name="go-practice" class="home-tile"><ui:VisualElement class="tile-icon art-gamepad" /><ui:Label text="Jugar" class="tile-title" /><ui:Label text="Practica y aprende" class="tile-subtitle" /></ui:Button>
<ui:Button name="go-subjects" class="home-tile"><ui:VisualElement class="tile-icon art-book" /><ui:Label text="Materias" class="tile-title" /><ui:Label text="Explora tus cursos" class="tile-subtitle" /></ui:Button>
</ui:VisualElement><ui:VisualElement class="tile-row">
<ui:Button name="go-history" class="home-tile"><ui:VisualElement class="tile-icon art-trophy" /><ui:Label text="Historial" class="tile-title" /><ui:Label text="Revisa tus progreso" class="tile-subtitle" /></ui:Button>
<ui:Button name="go-profile" class="home-tile"><ui:VisualElement class="tile-icon art-bars" /><ui:Label text="Perfil" class="tile-title" /><ui:Label text="Tu información" class="tile-subtitle" /></ui:Button></ui:VisualElement></ui:VisualElement>
<ui:Label name="progress" text="Cargando actividades..." class="home-progress" /><ui:Button name="edit-profile" text="Editar mis datos" class="profile-link" /><ui:Label name="status" class="status" />
</ui:VisualElement></ui:ScrollView><ui:VisualElement name="home-menu-layer" class="home-menu-layer"><ui:VisualElement name="menu-backdrop" class="home-menu-backdrop" />
 <ui:VisualElement class="sidebar">
  <ui:VisualElement class="drawer-head"><ui:Button name="close-menu" class="drawer-close" text="✕" />
    <ui:VisualElement name="drawer-avatar" class="drawer-avatar art-avatar" />
    <ui:Label name="drawer-name" text="Estudiante" class="drawer-name" />
    <ui:Label name="drawer-level" text="Nivel 5" class="drawer-level" />
  </ui:VisualElement>
  <ui:Button name="nav-home" class="nav nav-active"><ui:VisualElement class="drawer-nav-icon art-navhome" /><ui:Label text="Inicio" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-practice" class="nav"><ui:VisualElement class="drawer-nav-icon art-navplay" /><ui:Label text="Jugar (Práctica)" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-subjects" class="nav"><ui:VisualElement class="drawer-nav-icon art-navsubjects" /><ui:Label text="Materias" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-history" class="nav"><ui:VisualElement class="drawer-nav-icon art-navhistory" /><ui:Label text="Historial" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-profile" class="nav"><ui:VisualElement class="drawer-nav-icon art-navprofile" /><ui:Label text="Perfil" class="drawer-nav-label" /></ui:Button>
  <ui:VisualElement class="drawer-divider" />
  <ui:VisualElement class="drawer-spacer" />
  <ui:Button name="nav-logout" class="danger logout"><ui:VisualElement class="drawer-nav-icon art-navlogout" /><ui:Label text="Cerrar sesión" class="drawer-nav-label" /></ui:Button>
 </ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement>
</ui:UXML>
