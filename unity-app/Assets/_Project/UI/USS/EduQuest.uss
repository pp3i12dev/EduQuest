/* EduQuest - UI Toolkit runtime theme - Unity 6. No uGUI for screens. */
.screen { flex-grow: 1; background-color: rgb(12,18,42); color: rgb(236,245,255); }
.page-scroll { flex-grow: 1; }
.container { flex-grow: 1; padding-top: 28px; padding-bottom: 28px; padding-left: 48px; padding-right: 48px; }
.center { align-items: center; justify-content: center; }
.brand { font-size: 42px; color: rgb(77,225,217); -unity-font-style: bold; margin-bottom: 16px; }
.heading { font-size: 34px; color: rgb(248,250,255); -unity-font-style: bold; margin-bottom: 9px; }
.subheading { font-size: 16px; color: rgb(162,181,213); margin-bottom: 24px; }
.eyebrow { font-size: 13px; color: rgb(85,220,210); -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 12px; }
.glass { background-color: rgb(25,37,72); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-color: rgb(43,65,104); padding-top: 24px; padding-bottom: 24px; padding-left: 28px; padding-right: 28px; margin-bottom: 17px; }
.auth { width: 650px; max-width: 95%; }
.form-wide { width: 880px; max-width: 98%; }
.primary, .secondary, .ghost, .nav, .danger { height: 46px; padding-left: 20px; padding-right: 20px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; margin-bottom: 10px; -unity-font-style: bold; font-size: 15px; }
.primary { background-color: rgb(26,171,174); color: rgb(7,23,44); border-top-width: 0px; border-bottom-width: 0px; border-left-width: 0px; border-right-width: 0px; }
.secondary { background-color: rgb(70,76,166); color: white; border-top-width: 0px; border-bottom-width: 0px; border-left-width: 0px; border-right-width: 0px; }
.ghost { background-color: rgb(33,50,81); color: rgb(202,223,243); border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-color: rgb(72,100,141); }
.danger { background-color: rgb(105,42,78); color: rgb(255,224,231); }
.primary:hover { background-color: rgb(73,224,214); }
.secondary:hover { background-color: rgb(95,105,221); }
.ghost:hover, .nav:hover { background-color: rgb(49,71,112); }
.text { color: rgb(215,229,248); font-size: 17px; white-space: normal; }
.muted { color: rgb(161,182,208); font-size: 14px; white-space: normal; }
.stat-number { font-size: 36px; color: rgb(255,212,95); -unity-font-style: bold; }
.stat-label { color: rgb(169,200,232); font-size: 13px; }
.row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.gap { margin-right: 14px; }
.grid-row { flex-direction: row; flex-wrap: wrap; }
.stat { min-width: 175px; flex-grow: 1; margin-right: 12px; }
.field { margin-bottom: 13px; color: rgb(230,243,252); }
.field > .unity-text-field__input, .field > .unity-base-field__input { background-color: rgb(14,26,55); color: rgb(242,248,255); border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-top-left-radius: 8px; border-top-right-radius: 8px; }
.status { min-height: 24px; color: rgb(255,197,100); font-size: 14px; margin-top: 6px; margin-bottom: 10px; white-space: normal; }
.layout { flex-direction: row; flex-grow: 1; }
.sidebar { width: 225px; background-color: rgb(17,27,57); padding-top: 30px; padding-left: 15px; padding-right: 15px; padding-bottom: 22px; border-right-width: 1px; border-right-color: rgb(52,69,109); }
.nav { background-color: rgb(25,37,73); color: rgb(217,232,255); margin-top: 6px; -unity-text-align: middle-left; border-width: 0px; }
.logout { margin-top: auto; }
.content { flex-grow: 1; padding-left: 35px; padding-right: 35px; padding-top: 30px; }
.main-scroll { flex-grow: 1; }
.list-row { flex-direction: row; justify-content: space-between; align-items: center; padding-top: 18px; padding-bottom: 18px; padding-left: 20px; padding-right: 20px; margin-bottom: 10px; background-color: rgb(28,44,80); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
.list-info { flex-grow: 1; margin-right: 16px; }
.list-title { color: rgb(246,250,255); font-size: 19px; -unity-font-style: bold; white-space: normal; }
.list-subtitle { color: rgb(151,183,220); font-size: 13px; white-space: normal; }
.list-action { width: 158px; min-width: 158px; }
.pill { color: rgb(61,228,209); font-size: 14px; margin-top: 10px; }
.avatar { width: 132px; height: 132px; align-self: center; margin-bottom: 18px; background-color: rgb(51,86,123); border-radius: 66px; -unity-background-scale-mode: scale-to-fit; }
.spacer { height: 18px; }
.split { flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap; }
.question { font-size: 21px; color: white; margin-bottom: 22px; white-space: normal; }
.answer { min-width: 200px; margin-right: 12px; }

/* ---------------- Android / telefono: estilos con clase aplicada por EduQuestMobileLayout. ---------------- */
.mobile-portrait { flex-grow: 1; }
.mobile-portrait .page-scroll { flex-grow: 1; }
.mobile-portrait .container { width: 100%; min-width: 0; padding-left: 18px; padding-right: 18px; padding-top: 25px; padding-bottom: 22px; }
.mobile-portrait .center { align-items: stretch; justify-content: flex-start; }
.mobile-portrait .brand { font-size: 35px; -unity-text-align: middle-center; margin-bottom: 12px; }
.mobile-portrait .heading { font-size: 26px; white-space: normal; margin-bottom: 8px; }
.mobile-portrait .subheading { font-size: 14px; white-space: normal; margin-bottom: 18px; }
.mobile-portrait .eyebrow { font-size: 11px; letter-spacing: 1px; }
.mobile-portrait .auth, .mobile-portrait .form-wide { width: 100%; max-width: 100%; min-width: 0; }
.mobile-portrait .glass { min-width: 0; padding-top: 18px; padding-bottom: 18px; padding-left: 17px; padding-right: 17px; margin-bottom: 12px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; }
.mobile-portrait .primary, .mobile-portrait .secondary, .mobile-portrait .ghost, .mobile-portrait .danger { min-height: 54px; height: auto; padding-top: 12px; padding-bottom: 12px; font-size: 15px; white-space: normal; }
.mobile-portrait .field { min-height: 64px; font-size: 15px; margin-bottom: 14px; }
.mobile-portrait .field > .unity-base-field__input { min-height: 42px; }
.mobile-portrait .text { font-size: 15px; }
.mobile-portrait .muted { font-size: 13px; }
.mobile-portrait .question { font-size: 19px; white-space: normal; }
.mobile-portrait .status { font-size: 13px; min-height: 34px; }
.mobile-portrait .layout { flex-direction: column; position: relative; flex-grow: 1; }
/* La barra original izquierda se convierte en dock inferior accesible al tacto. */
.mobile-portrait .sidebar { position: absolute; left: 0; right: 0; bottom: 0; top: auto; width: 100%; height: 73px; flex-direction: row; justify-content: space-around; align-items: center; padding-top: 7px; padding-bottom: 7px; padding-left: 4px; padding-right: 4px; border-right-width: 0px; border-top-width: 1px; border-top-color: rgb(50,77,114); }
.mobile-portrait .sidebar .brand { display: none; }
.mobile-portrait .sidebar .nav, .mobile-portrait .sidebar .logout { flex-grow: 1; flex-shrink: 1; min-width: 0; width: auto; height: 55px; min-height: 55px; margin-top: 0px; margin-bottom: 0px; margin-left: 2px; margin-right: 2px; padding-left: 2px; padding-right: 2px; padding-top: 8px; padding-bottom: 8px; font-size: 11px; -unity-text-align: middle-center; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-left-radius: 9px; border-bottom-right-radius: 9px; }
.mobile-portrait .sidebar .logout { background-color: rgb(84,44,74); }
.mobile-portrait .main-scroll { flex-grow: 1; margin-bottom: 74px; }
.mobile-portrait .content { padding-top: 21px; padding-bottom: 22px; padding-left: 16px; padding-right: 16px; min-width: 0; }
.mobile-portrait .list-row { flex-direction: column; align-items: stretch; padding-top: 15px; padding-bottom: 15px; padding-left: 14px; padding-right: 14px; margin-bottom: 10px; }
.mobile-portrait .list-info { flex-grow: 0; margin-right: 0; margin-bottom: 10px; }
.mobile-portrait .list-title { font-size: 17px; }
.mobile-portrait .list-subtitle { font-size: 13px; white-space: normal; }
.mobile-portrait .list-action { width: 100%; min-width: 0; height: 49px; min-height: 49px; }
.mobile-portrait .stat { min-width: 91px; flex-grow: 1; margin-right: 8px; margin-bottom: 10px; }
.mobile-portrait .stat-number { font-size: 29px; }
.mobile-portrait .stat-label { font-size: 11px; }
.mobile-portrait .avatar { width: 106px; height: 106px; border-top-left-radius: 53px; border-top-right-radius: 53px; border-bottom-left-radius: 53px; border-bottom-right-radius: 53px; margin-right: 12px; }
.mobile-portrait .row { flex-wrap: wrap; }
.mobile-portrait .row > .primary, .mobile-portrait .row > .secondary, .mobile-portrait .row > .ghost { flex-grow: 1; min-width: 120px; margin-right: 5px; }
.mobile-portrait .answer { min-width: 0; width: 100%; margin-right: 0; }
.mobile-portrait .featured-game { background-color: rgb(28,67,97); border-top-left-radius: 17px; border-top-right-radius: 17px; border-bottom-left-radius: 17px; border-bottom-right-radius: 17px; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-color: rgb(69,178,188); padding-top: 18px; padding-bottom: 18px; padding-left: 17px; padding-right: 17px; margin-bottom: 15px; }
.mobile-portrait .featured-tag { color: rgb(112,248,212); font-size: 12px; -unity-font-style: bold; margin-bottom: 8px; }
.mobile-portrait .featured-title { color: rgb(250,255,255); font-size: 23px; -unity-font-style: bold; margin-bottom: 9px; }
.mobile-portrait .featured-detail { color: rgb(195,228,245); font-size: 14px; white-space: normal; margin-bottom: 12px; }
.mobile-portrait .featured-action { width: 100%; min-height: 56px; }

/* EduQuest · Gold / amber UI. Textura con degradado real desde Resources. */
.primary { background-color: rgb(255,183,31); color: rgb(48,29,5); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
.primary:hover { background-color: rgb(255,207,71); color: rgb(35,24,10); }
.secondary { background-color: rgb(84,74,116); }
.auth-screen .auth-card { background-color: rgb(28,38,74); border-color: rgb(94,93,125); }
.auth-screen .auth-field { width: 100%; min-width: 0; flex-direction: column; align-items: stretch; margin-top: 8px; margin-bottom: 17px; }
.auth-screen .auth-field .unity-base-field__label { width: 100%; min-width: 0; font-size: 14px; color: rgb(248,228,190); padding-bottom: 6px; }
.auth-screen .auth-field .unity-base-field__input { flex-grow: 0; min-width: 0; width: 100%; min-height: 49px; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom-left-radius: 11px; border-bottom-right-radius: 11px; border-color: rgb(103,107,142); border-width: 1px; background-color: rgb(16,26,53); }
.auth-screen .auth-field .unity-text-field__input { color: rgb(251,251,255); }
.auth-screen .auth-submit { margin-top: 17px; }
.auth-screen .link-button { align-self: flex-end; border-width: 0; background-color: rgba(0,0,0,0); color: rgb(255,198,77); font-size: 14px; -unity-text-align: middle-right; height: 37px; margin-bottom: 8px; }
.auth-screen .link-button:hover { color: rgb(255,230,165); }
.hero-card { border-color: rgb(86,88,148); background-color: rgb(33,45,87); }
.hero-info { align-items: center; justify-content: center; }
.hero-avatar { border-color: rgb(255,197,67); border-width: 3px; width: 142px; height: 142px; border-radius: 71px; margin-right: 0; }
.hero-name { color: white; font-size: 27px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; margin-bottom: 6px; }
.hero-role { color: rgb(255,198,83); -unity-font-style: bold; font-size: 12px; margin-bottom: 15px; }
.profile-action { align-self: center; }
.home-topbar { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.home-menu { display: none; width: 56px; font-size: 28px; -unity-text-align: middle-center; }
.home-stats { flex-direction: row; justify-content: space-between; margin-bottom: 10px; }
.stat-card { align-items: center; flex-grow: 1; min-width: 0; background-color: rgb(31,46,88); padding-top: 15px; padding-bottom: 14px; padding-left: 6px; padding-right: 6px; margin-right: 6px; border-radius: 15px; }
.stat-icon { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 7px; }
.stat-card .stat-number { color: rgb(255,209,83); }
.stat-card .stat-label { color: rgb(186,207,241); }
.mobile-portrait.home-mobile .home-menu { display: flex; align-items: center; justify-content: center; }
.mobile-portrait.home-mobile .sidebar { display: none; position: absolute; z-index: 100; left: 0; top: 0; right: auto; bottom: auto; width: 260px; height: auto; flex-direction: column; align-items: stretch; justify-content: flex-start; padding-top: 26px; padding-bottom: 25px; padding-left: 12px; padding-right: 12px; border-right-width: 1px; border-right-color: rgb(85,102,152); border-top-width: 0; }
.mobile-portrait.home-mobile.menu-open .sidebar { display: flex; }
.mobile-portrait.home-mobile .sidebar .brand { display: flex; -unity-text-align: middle-center; }
.mobile-portrait.home-mobile .sidebar .nav, .mobile-portrait.home-mobile .sidebar .logout { width: 100%; flex-grow: 0; min-height: 53px; font-size: 16px; -unity-text-align: middle-left; padding-left: 16px; }
.mobile-portrait.home-mobile .sidebar .logout { margin-top: 16px; }
.mobile-portrait.home-mobile .main-scroll { margin-bottom: 0; }
.mobile-portrait.home-mobile .home-content { padding-top: 18px; }
.mobile-portrait.home-mobile .hero-card { align-items: center; }
.mobile-portrait.home-mobile .hero-avatar { margin-right: 0; }
.mobile-portrait.home-mobile .hero-name { font-size: 23px; }
.mobile-portrait.home-mobile .home-stats .stat { min-width: 0; margin-right: 5px; }
.mobile-portrait.home-mobile .stat-icon { width: 39px; height: 39px; }
.mobile-portrait.home-mobile .stat-number { font-size: 25px; }
.mobile-portrait.home-mobile .stat-label { font-size: 11px; }
