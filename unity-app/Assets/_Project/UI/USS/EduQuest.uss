/* EduQuest - UI Toolkit runtime theme - Unity 6. No uGUI for screens. */
.screen { flex-grow: 1; background-color: rgb(12,18,42); color: rgb(236,245,255); }
.page-scroll { flex-grow: 1; }
.container { flex-grow: 1; padding-top: 28px; padding-bottom: 28px; padding-left: 48px; padding-right: 48px; }
.center { align-items: center; justify-content: center; }
.brand { font-size: 42px; color: rgb(77,225,217); -unity-font-style: bold; margin-bottom: 16px; }
.heading { font-size: 34px; color: rgb(248,250,255); -unity-font-style: bold; margin-bottom: 9px; }
.subheading { font-size: 16px; color: rgb(162,181,213); margin-bottom: 24px; }
.eyebrow { font-size: 13px; color: rgb(85,220,210); -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 12px; }
.glass { background-color: rgb(25,37,72); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-color: rgb(43,65,104); padding-top: 24px; padding-bottom: 24px; padding-left: 28px; padding-right: 28px; margin-bottom: 17px; }
.auth { width: 650px; max-width: 95%; }
.form-wide { width: 880px; max-width: 98%; }
.primary, .secondary, .ghost, .nav, .danger { height: 46px; padding-left: 20px; padding-right: 20px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; margin-bottom: 10px; -unity-font-style: bold; font-size: 15px; }
.primary { background-color: rgb(26,171,174); color: rgb(7,23,44); border-top-width: 0px; border-bottom-width: 0px; border-left-width: 0px; border-right-width: 0px; }
.secondary { background-color: rgb(70,76,166); color: white; border-top-width: 0px; border-bottom-width: 0px; border-left-width: 0px; border-right-width: 0px; }
.ghost { background-color: rgb(33,50,81); color: rgb(202,223,243); border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-color: rgb(72,100,141); }
.danger { background-color: rgb(105,42,78); color: rgb(255,224,231); }
.primary:hover { background-color: rgb(73,224,214); }
.secondary:hover { background-color: rgb(95,105,221); }
.ghost:hover, .nav:hover { background-color: rgb(49,71,112); }
.text { color: rgb(215,229,248); font-size: 17px; white-space: normal; }
.muted { color: rgb(161,182,208); font-size: 14px; white-space: normal; }
.stat-number { font-size: 36px; color: rgb(255,212,95); -unity-font-style: bold; }
.stat-label { color: rgb(169,200,232); font-size: 13px; }
.row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.gap { margin-right: 14px; }
.grid-row { flex-direction: row; flex-wrap: wrap; }
.stat { min-width: 175px; flex-grow: 1; margin-right: 12px; }
.field { margin-bottom: 13px; color: rgb(230,243,252); }
.field > .unity-text-field__input, .field > .unity-base-field__input { background-color: rgb(14,26,55); color: rgb(242,248,255); border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-top-left-radius: 8px; border-top-right-radius: 8px; }
.status { min-height: 24px; color: rgb(255,197,100); font-size: 14px; margin-top: 6px; margin-bottom: 10px; white-space: normal; }
.layout { flex-direction: row; flex-grow: 1; }
.sidebar { width: 225px; background-color: rgb(17,27,57); padding-top: 30px; padding-left: 15px; padding-right: 15px; padding-bottom: 22px; border-right-width: 1px; border-right-color: rgb(52,69,109); }
.nav { background-color: rgb(25,37,73); color: rgb(217,232,255); margin-top: 6px; -unity-text-align: middle-left; border-width: 0px; }
.logout { margin-top: auto; }
.content { flex-grow: 1; padding-left: 35px; padding-right: 35px; padding-top: 30px; }
.main-scroll { flex-grow: 1; }
.list-row { flex-direction: row; justify-content: space-between; align-items: center; padding-top: 18px; padding-bottom: 18px; padding-left: 20px; padding-right: 20px; margin-bottom: 10px; background-color: rgb(28,44,80); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
.list-info { flex-grow: 1; margin-right: 16px; }
.list-title { color: rgb(246,250,255); font-size: 19px; -unity-font-style: bold; white-space: normal; }
.list-subtitle { color: rgb(151,183,220); font-size: 13px; white-space: normal; }
.list-action { width: 158px; min-width: 158px; }
.pill { color: rgb(61,228,209); font-size: 14px; margin-top: 10px; }
.avatar { width: 132px; height: 132px; align-self: center; margin-bottom: 18px; background-color: rgb(51,86,123); border-radius: 66px; -unity-background-scale-mode: scale-to-fit; }
.spacer { height: 18px; }
.split { flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap; }
.question { font-size: 21px; color: white; margin-bottom: 22px; white-space: normal; }
.answer { min-width: 200px; margin-right: 12px; }
