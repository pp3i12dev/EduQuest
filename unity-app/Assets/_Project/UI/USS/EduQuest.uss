.eq-theme .recovery-envelope { width: 206px; height: 168px; margin-top: 12px; margin-bottom: 14px; }
.eq-theme .recovery-layout { padding-top: 4px; }
.eq-theme .home-mobile .home-topbar { padding-top: 2px; }
.eq-theme .home-top-stats { gap: 4px; }
.eq-theme .tile-row { gap: 12px; }
.eq-theme .home-tile { padding-left: 8px; padding-right: 8px; }
.eq-theme.eq-compact .home-content, .eq-theme.eq-compact .generic-content, .eq-theme.eq-compact .container.auth-layout, .eq-theme.eq-compact .container.register-layout { max-width: 356px; }
.eq-theme.eq-compact .student-card { min-height: 120px; }
.eq-theme.eq-compact .home-tile { height: 148px; }
.eq-theme.eq-compact .featured-title { font-size: 21px; }
.eq-theme.eq-compact .drawer-name { margin-top: -68px; }


/* === Revisión profunda final: welcome/logo/alineación general === */
.eq-theme .container.auth-layout {
    padding-top: 18px;
    padding-bottom: 22px;
}
.eq-theme .welcome-layout,
.eq-theme .auth-card-layout,
.eq-theme .recovery-layout {
    justify-content: center;
    align-items: center;
}
.eq-theme .welcome-layout .heading,
.eq-theme .welcome-layout .subheading,
.eq-theme .auth-card-layout .heading,
.eq-theme .auth-card-layout .subheading,
.eq-theme .recovery-layout .heading,
.eq-theme .recovery-layout .subheading {
    text-align: center;
    -unity-text-align: middle-center;
}
.eq-theme .welcome-layout .auth-actions {
    width: 100%;
    max-width: 360px;
    align-self: center;
    margin-top: 20px;
}
.eq-theme .logo-group {
    width: 300px;
    align-self: center;
}
.eq-theme .logo-group.large {
    width: 300px;
    height: 150px;
    margin-top: 10px;
    margin-bottom: 12px;
}
.eq-theme .logo-star {
    width: 118px;
    height: 110px;
    margin-bottom: -24px;
    align-self: center;
}
.eq-theme .logo-text {
    width: 300px;
    height: 76px;
    align-self: center;
}
.eq-theme .welcome-screen .logo-group,
.eq-theme .login-screen .logo-group {
    margin-top: 8px;
}
.eq-theme .welcome-screen .auth-actions,
.eq-theme .login-screen .auth-fields {
    margin-top: 12px;
}
.eq-theme .page-scroll,
.eq-theme .main-scroll {
    padding-top: 0;
}
.eq-theme .home-content,
.eq-theme .generic-content,
.eq-theme .container.auth-layout,
.eq-theme .container.register-layout {
    padding-top: 16px;
}
.eq-theme .content {
    padding-top: 16px;
}
.eq-theme .home-topbar { margin-top: 2px; }
.eq-theme .home-menu-layer .sidebar .nav-active { display:flex; align-items:center; }
.eq-theme .home-menu-layer .sidebar .logout { display:flex; align-items:center; }
.eq-theme .drawer-head { margin-bottom: 10px; }
.eq-theme .drawer-avatar { background-position: center center; }
.eq-theme .hero-avatar { background-position: center center; }
/* quita cualquier rigidez extra en las pantallas verticales */
.eq-theme .screen { justify-content: flex-start; }
.eq-theme.eq-compact .container.auth-layout {
    padding-top: 10px;
    padding-bottom: 14px;
}
.eq-theme.eq-compact .logo-group.large {
    width: 274px;
    height: 132px;
    margin-top: 6px;
}
.eq-theme.eq-compact .logo-text { width: 274px; height: 68px; }
.eq-theme.eq-compact .logo-star { width: 108px; height: 98px; }

/* Opciones multiples evaluativas: botones tactiles, sin ancho horizontal. */
.eq-theme .answer-options { width: 100%; min-width: 0; }
.eq-theme .choice-answer { min-height: 54px; margin-bottom: 10px; white-space: normal; width: 100%; }

/* Entrega 3: árbol académico del alumno (respeta la apariencia existente). */
.curriculum-unit { background-color: rgb(28,40,77); padding: 16px; border-radius: 16px; margin-bottom: 16px; border-color: rgb(64,84,142); border-width: 1px; }
.curriculum-unit-tag { color: rgb(255,200,99); font-size: 11px; -unity-font-style: bold; margin-bottom: 5px; }
.curriculum-unit-title { color: rgb(253,247,235); font-size: 22px; -unity-font-style: bold; white-space: normal; margin-bottom: 8px; }
.curriculum-description { color: rgb(197,210,233); font-size: 13px; white-space: normal; margin-bottom: 11px; }
.curriculum-topic { background-color: rgb(39,53,96); padding: 12px; margin-top: 9px; border-radius: 12px; }
.curriculum-topic-title { color: rgb(122,238,230); font-size: 17px; -unity-font-style: bold; white-space: normal; margin-bottom: 6px; }
.curriculum-section { color: rgb(255,211,116); font-size: 11px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 6px; }
.eq-tab-active { background-color: rgb(255,188,58); color: rgb(39,26,8); }
.mobile-portrait .curriculum-unit { padding: 12px; margin-bottom: 12px; }
.mobile-portrait .curriculum-unit-title { font-size: 19px; }
.mobile-portrait .curriculum-topic-title { font-size: 15px; }
.mobile-portrait .curriculum-topic .list-row { flex-direction: column; }
.mobile-portrait .curriculum-topic .list-info { width: 100%; }
.mobile-portrait .curriculum-topic .list-action { width: 100%; }

/* Entrega 4: revisión accesible desde móvil. */
.history-card {
  background-color: rgba(255,255,255,0.88);
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 12px;
}
.history-actions { flex-direction: row; flex-wrap: wrap; margin-top: 9px; margin-bottom: 7px; }
.history-actions .secondary { margin-right: 7px; margin-bottom: 5px; }
.review-items { margin-top: 12px; margin-bottom: 12px; }
.review-answer {
  padding: 11px;
  border-radius: 10px;
  margin-top: 8px;
  background-color: rgba(250,250,250,0.94);
  border-left-width: 5px;
}
.review-answer-correct { border-left-color: rgb(24, 160, 99); }
.review-answer-wrong { border-left-color: rgb(214, 78, 78); }

/* Entrega 5 — Unir conceptos: dos columnas responsive y selección táctil. */
.eq-theme .matching-board { width: 100%; flex-direction: column; margin-top: 14px; margin-bottom: 16px; }
.eq-theme .matching-columns { width: 100%; flex-direction: row; align-items: stretch; }
.eq-theme .matching-column { width: 50%; flex-grow: 1; flex-shrink: 1; min-width: 0; padding-left: 5px; padding-right: 5px; }
.eq-theme .matching-column .eyebrow { color: rgb(66,47,136); font-size: 12px; margin-bottom: 9px; -unity-font-style: bold; }
.eq-theme .matching-tile { width: 100%; white-space: normal; -unity-text-align: middle-center; font-size: 14px; color: rgb(43,30,115); background-color: rgb(247,243,255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(181,168,234); border-right-color: rgb(181,168,234); border-bottom-color: rgb(181,168,234); border-left-color: rgb(181,168,234); border-radius: 12px; min-height: 62px; height: auto; padding-top: 10px; padding-bottom: 10px; padding-left: 8px; padding-right: 8px; margin-bottom: 8px; }
.eq-theme .matching-selected { background-color: rgb(253,233,151); border-top-color: rgb(226,172,33); border-right-color: rgb(226,172,33); border-bottom-color: rgb(226,172,33); border-left-color: rgb(226,172,33); }
.eq-theme .matching-connected { background-color: rgb(213,250,235); border-top-color: rgb(73,176,143); border-right-color: rgb(73,176,143); border-bottom-color: rgb(73,176,143); border-left-color: rgb(73,176,143); }
.eq-theme .matching-pair-label { color: rgb(36,114,90); white-space: normal; font-size: 12px; margin-bottom: 13px; }

/* Entrega avatar (portrait): 3 columnas táctiles sin scroll horizontal. */
.eq-theme .logo-group.small { width: 122px; min-width: 0; height: 61px; flex-shrink: 1; margin: 0; }
.eq-theme .logo-group.small .logo-star { width: 49px; height: 47px; margin-bottom: -9px; }
.eq-theme .logo-group.small .logo-text { width: 121px; height: 32px; }
.eq-theme .hero-avatar { flex-shrink: 0; align-self: center; background-color: white; }
.eq-theme .eq-avatar-settings { padding: 14px; margin-bottom: 15px; }
.eq-theme .eq-avatar-head { flex-direction: row; align-items: center; justify-content: space-between; min-width: 0; margin-top: 10px; margin-bottom: 12px; }
.eq-theme .eq-avatar-preview { width: 76px; height: 76px; min-width: 76px; border-radius: 38px; border-width: 3px; border-color: rgb(255,187,17); background-color: white; -unity-background-scale-mode: scale-to-fit; }
.eq-theme .eq-avatar-tabs { flex-direction: row; justify-content: flex-end; flex-grow: 1; margin-left: 8px; min-width: 0; }
.eq-theme .eq-avatar-tab { flex-grow: 1; min-width: 0; height: 43px; margin-left: 4px; border-radius: 17px; background-color: rgb(239,230,254); color: rgb(65,44,140); -unity-font-style: bold; font-size: 13px; }
.eq-theme .eq-avatar-tab-active { background-color: rgb(115,61,225); color: white; }
.eq-theme .eq-avatar-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; width: 100%; }
.eq-theme .eq-avatar-item { width: 31%; min-width: 0; height: 90px; min-height: 90px; margin-bottom: 9px; border-radius: 18px; border-width: 2px; border-color: rgb(211,198,243); background-color: rgb(255,255,255); -unity-background-scale-mode: scale-to-fit; }
.eq-theme .eq-avatar-selected { border-width: 4px; border-color: rgb(255,162,0); background-color: rgb(255,244,210); }
.eq-theme .eq-avatar-save { margin-bottom: 0; width: 100%; }
.eq-theme.eq-compact .eq-avatar-item { height: 74px; min-height: 74px; }

/* Entrega 6 — Preferencias de sonido (portrait). */
.eq-theme .eq-audio-settings { margin-top: 10px; margin-bottom: 16px; padding: 14px; }
.eq-theme .eq-audio-settings .secondary { margin-top: 10px; width: 100%; min-height: 44px; }
.eq-theme .eq-audio-volume { margin-top: 12px; min-height: 44px; width: 100%; }
.eq-theme .eq-review-audio { margin-top: 7px; align-self: flex-start; min-height: 38px; }

/* Entrega 14 — Juegos conceptuales: tarjetas táctiles responsive para portrait. */
.eq-theme .game-option-tile {
    width: 100%; min-height: 56px; height: auto; white-space: normal;
    color: rgb(62, 36, 135); background-color: rgb(249, 244, 255);
    border-radius: 16px; border-width: 2px; border-color: rgb(185, 170, 235);
    -unity-text-align: middle-center; font-size: 16px;
    padding-left: 14px; padding-right: 14px; padding-top: 12px; padding-bottom: 12px;
    margin-top: 4px; margin-bottom: 8px;
}
.eq-theme .game-option-tile:hover { background-color: rgb(231, 219, 253); border-color: rgb(116, 71, 215); }
.eq-theme .game-selection-list { width: 100%; margin-bottom: 10px; }
.eq-theme .game-chosen-step {
    width: 100%; white-space: normal; font-size: 14px; color: rgb(47, 125, 85);
    background-color: rgb(220, 248, 231); border-radius: 12px;
    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
    margin-bottom: 5px;
}

/* Entrega 15: memotest y etiquetado interactivo - orientación portrait */
.eq-theme .eq-memory-board { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 100%; }
.eq-theme .eq-memory-card { width: 30%; min-width: 0; min-height: 90px; height: auto; margin: 1.5%; padding: 8px; white-space: normal; font-size: 13px; -unity-font-style: bold; background-color: rgb(92, 48, 171); color: white; border-radius: 15px; border-width: 2px; border-color: rgb(235, 205, 255); }
.eq-theme .eq-memory-flipped { background-color: rgb(255, 215, 111); color: rgb(54, 34, 101); }
.eq-theme .eq-memory-paired { background-color: rgb(202, 250, 218); color: rgb(41, 90, 58); }
.eq-theme .eq-diagram-frame { width: 100%; min-height: 130px; position: relative; margin-bottom: 12px; border-radius: 12px; background-color: white; }
.eq-theme .eq-diagram-pin { position: absolute; width: 36px; height: 36px; border-radius: 18px; border-width: 2px; border-color: white; background-color: rgb(104, 65, 210); color: white; -unity-font-style: bold; translate: -50% -50%; }
.eq-theme .eq-diagram-answered { background-color: rgb(58, 177, 101); color: white; }
.eq-theme .eq-diagram-selected { background-color: rgb(255, 180, 32); color: rgb(43, 31, 89); border-color: rgb(80, 50, 145); }

/* Entrega 16: resultados adaptados a celulares + tabla de posiciones */
.eq-theme .stat-number, .eq-theme .result-compact-number { width: 100%; min-width: 0; max-width: 100%; white-space: normal; -unity-text-align: middle-center; font-size: 23px; }
.eq-theme .generic-result .stat-number { font-size: 22px; margin-bottom: 8px; }
.eq-theme .generic-result .text, .eq-theme .history-card .list-subtitle { width: 100%; min-width: 0; max-width: 100%; white-space: normal; font-size: 12px; }
.eq-theme .generic-result .glass, .eq-theme .generic-history .glass { width: 100%; min-width: 0; padding-left: 12px; padding-right: 12px; }
.eq-theme .history-card { width: 100%; min-width: 0; max-width: 100%; }
.eq-theme .eq-ranking-tabs { width: 100%; flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.eq-theme .eq-ranking-tab { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 4px; padding: 9px; min-height: 46px; border-radius: 11px; color: rgb(67,47,138); background-color: rgb(232,222,250); -unity-font-style: bold; }
.eq-theme .eq-ranking-tab-active { background-color: rgb(255,203,75); color: rgb(39,29,80); }
.eq-theme .eq-ranking-entry { width: 100%; flex-direction: row; align-items: center; padding: 10px; margin-bottom: 8px; border-radius: 12px; background-color: rgb(245,239,255); }
.eq-theme .eq-ranking-place { width: 43px; min-width: 43px; font-size: 18px; color: rgb(107,66,181); -unity-font-style: bold; }
.eq-theme .eq-ranking-person { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.eq-theme .eq-ranking-name { color: rgb(54,39,112); -unity-font-style: bold; white-space: normal; font-size: 14px; }
.eq-theme .eq-ranking-points { color: rgb(65,55,128); white-space: normal; font-size: 12px; }
.eq-theme .eq-ranking-mine { background-color: rgb(255,237,164); }
.eq-theme .eq-ranking-home { width: 100%; min-height: 90px; }
.eq-theme .eq-ranking-activity-select { width: 100%; min-width: 0; margin-bottom: 11px; }
