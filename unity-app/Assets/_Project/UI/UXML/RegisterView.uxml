<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/Theme.uss" />
    <Style src="../USS/RegisterView.uss" />
    <ui:ScrollView name="register-scroll">
        <ui:VisualElement name="register-container" class="screen">
            <ui:Label text="Crear cuenta" class="title" />
            <ui:Label text="Completá tus datos para registrarte" class="subtitle" />

            <ui:TextField name="firstname-field" label="Nombre" />
            <ui:TextField name="lastname-field" label="Apellido" />
            <ui:TextField name="dni-field" label="DNI" />
            <ui:TextField name="email-field" label="Email" />
            <ui:TextField name="password-field" label="Contraseña" password="true" />

            <ui:DropdownField name="institution-dropdown" label="Institución" />
            <ui:DropdownField name="career-dropdown" label="Carrera / Nivel" />
            <ui:DropdownField name="course-dropdown" label="Curso" />

            <ui:Button name="register-button" text="Registrarme" class="primary-button" />
            <ui:Label name="error-label" class="error-text" />
            <ui:Label name="success-label" class="success-text" />

            <ui:Button name="back-button" text="Ya tengo cuenta — Ingresar" class="link-button" />
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>