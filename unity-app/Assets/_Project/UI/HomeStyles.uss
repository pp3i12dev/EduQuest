.container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(18, 24, 38);
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
}

.header {
    align-items: center;
    margin-bottom: 40px;
}

.title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.subtitle {
    font-size: 18px;
    color: rgb(156, 163, 175);
    -unity-text-align: middle-center;
}

.button-group {
    width: 320px;
    align-items: stretch;
}

.btn-primary {
    background-color: rgb(79, 70, 229);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 8px;
    margin-bottom: 12px;
    border-width: 0;
    transition-duration: 0.15s;
}

.btn-primary:hover {
    background-color: rgb(67, 56, 202);
}

.btn-secondary {
    background-color: rgb(31, 41, 55);
    color: rgb(243, 244, 246);
    font-size: 16px;
    -unity-font-style: bold;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 8px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: rgb(75, 85, 99);
    transition-duration: 0.15s;
}

.btn-secondary:hover {
    background-color: rgb(55, 65, 81);
}

.btn-accent {
    background-color: rgb(16, 185, 129);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 8px;
    margin-bottom: 12px;
    border-width: 0;
    transition-duration: 0.15s;
}

.btn-accent:hover {
    background-color: rgb(5, 150, 105);
}