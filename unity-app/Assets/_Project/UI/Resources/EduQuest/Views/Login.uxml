<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../../USS/EduQuest.uss" />
    <ui:VisualElement class="screen auth-screen">
        <ui:ScrollView class="page-scroll">
            <ui:VisualElement class="container center">
                <ui:Label text="✦  EDUQUEST" class="brand" />
                <ui:Label text="¡Qué bueno verte!" class="heading" />
                <ui:Label text="Iniciá sesión y continuá tu aventura." class="subheading" />
                <ui:VisualElement class="glass auth auth-card">
                    <ui:Label text="ACCESO DE ALUMNOS" class="eyebrow" />
                    <ui:TextField name="identity" label="Correo electrónico o DNI" class="field auth-field" />
                    <ui:TextField name="password" label="Contraseña" class="field auth-field" />
                    <ui:Button name="forgot" text="¿Olvidaste tu contraseña?" class="link-button" />
                    <ui:Button name="submit" text="ENTRAR A EDUQUEST" class="primary auth-submit" />
                    <ui:Button name="back" text="Volver" class="ghost" />
                </ui:VisualElement>
                <ui:Label name="status" class="status" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
