<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../../USS/EduQuest.uss" />
<ui:VisualElement class="screen"><ui:VisualElement class="layout"><ui:VisualElement class="sidebar"><ui:Label text="EDUQUEST" class="brand" />
        <ui:Button name="nav-home" text="⌂   Inicio" class="nav" />
        <ui:Button name="nav-subjects" text="▤   Materias" class="nav" />
        <ui:Button name="nav-practice" text="▶   Jugar" class="nav" />
        <ui:Button name="nav-history" text="★   Historial" class="nav" />
        <ui:Button name="nav-profile" text="◉   Mi perfil" class="nav" />
        <ui:Button name="nav-logout" text="Cerrar sesión" class="danger logout" />
        </ui:VisualElement><ui:ScrollView class="main-scroll"><ui:VisualElement class="content"><ui:Label text="¡A jugar!" class="heading" /><ui:Label text="Respondé las preguntas. La corrección se realiza en el backend." class="subheading" /><ui:VisualElement class="glass"><ui:Label name="game-title" class="question" /><ui:Label name="question-position" class="muted" /><ui:Label name="question-text" class="question" /><ui:VisualElement class="row"><ui:Button name="true" text="Verdadero" class="primary" /><ui:Button name="false" text="Falso" class="secondary" /></ui:VisualElement><ui:Button name="finish" text="Finalizar partida" class="ghost" /><ui:Button name="back" text="Salir del juego" class="ghost" /></ui:VisualElement><ui:Label name="status" class="status" /></ui:VisualElement></ui:ScrollView></ui:VisualElement></ui:VisualElement>
</ui:UXML>
