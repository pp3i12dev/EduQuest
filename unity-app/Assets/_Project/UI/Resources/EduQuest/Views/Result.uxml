        </ui:VisualElement><ui:ScrollView class="main-scroll"><ui:VisualElement class="content"><ui:Label text="Resultado de la partida" class="heading" /><ui:Label text="¡Cada intento es una oportunidad para aprender!" class="subheading" /><ui:VisualElement class="glass"><ui:Label name="result-score" class="stat-number" /><ui:Label name="result-details" class="text" /><ui:Button name="home" text="Volver al inicio" class="primary" /><ui:Button name="history" text="Ver historial" class="ghost" /><ui:Button name="practice" text="Seguir practicando" class="secondary" /></ui:VisualElement><ui:Label name="status" class="status" /></ui:VisualElement></ui:ScrollView></ui:VisualElement></ui:VisualElement>
