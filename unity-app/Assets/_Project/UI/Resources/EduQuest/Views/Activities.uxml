<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../../USS/EduQuest.uss" />
<ui:VisualElement class="screen"><ui:VisualElement class="layout"><ui:VisualElement class="sidebar"><ui:Label text="EDUQUEST" class="brand" />
        <ui:Button name="nav-home" text="⌂   Inicio" class="nav" />
        <ui:Button name="nav-subjects" text="▤   Materias" class="nav" />
        <ui:Button name="nav-practice" text="▶   Jugar" class="nav" />
        <ui:Button name="nav-history" text="★   Historial" class="nav" />
        <ui:Button name="nav-profile" text="◉   Mi perfil" class="nav" />
        <ui:Button name="nav-logout" text="Cerrar sesión" class="danger logout" />
        </ui:VisualElement><ui:ScrollView class="main-scroll"><ui:VisualElement class="content"><ui:Label text="Desafíos por materia" class="heading" /><ui:Label text="Elegí pendientes o completados." class="subheading" /><ui:VisualElement class="glass"><ui:Label name="subject-name" class="question" /><ui:VisualElement class="row"><ui:Button name="pending" text="Pendientes" class="primary" /><ui:Button name="completed" text="Completadas" class="secondary" /><ui:Button name="back" text="Volver a materias" class="ghost" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="glass"><ui:VisualElement name="items" /></ui:VisualElement><ui:Label name="status" class="status" /></ui:VisualElement></ui:ScrollView></ui:VisualElement></ui:VisualElement>
</ui:UXML>
