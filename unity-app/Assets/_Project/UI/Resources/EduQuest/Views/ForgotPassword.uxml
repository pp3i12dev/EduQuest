<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../../USS/EduQuest.uss" />
    <ui:VisualElement class="screen auth-screen">
        <ui:ScrollView class="page-scroll">
            <ui:VisualElement class="container center">
                <ui:Label text="✦  EDUQUEST" class="brand" />
                <ui:Label text="Recuperá tu acceso" class="heading" />
                <ui:Label text="Te enviaremos un enlace seguro a tu correo electrónico." class="subheading" />
                <ui:VisualElement class="glass auth auth-card">
                    <ui:Label text="RECUPERACIÓN DE CONTRASEÑA" class="eyebrow" />
                    <ui:TextField name="email" label="Correo electrónico" class="field auth-field" />
                    <ui:Button name="send" text="ENVIAR ENLACE" class="primary" />
                    <ui:Label name="recovery-note" class="muted" text="El enlace se abre en el navegador y vence a los 15 minutos." />
                    <ui:Button name="back" text="Volver a iniciar sesión" class="ghost" />
                </ui:VisualElement>
                <ui:Label name="status" class="status" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
