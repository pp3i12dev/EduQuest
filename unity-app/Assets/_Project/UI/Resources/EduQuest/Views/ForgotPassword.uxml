<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../../USS/EduQuest.uss" />
<ui:VisualElement class="screen eq-theme forgot-screen auth-screen"><ui:ScrollView class="page-scroll eq-scroll"><ui:VisualElement class="container auth-layout recovery-layout">
<ui:Button name="back" text="‹" class="back-square" />
<ui:VisualElement class="recovery-envelope art-mail" />
<ui:Label text="Recuperar contraseña" class="heading title-centered" />
<ui:Label text="Ingresá tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña." class="subheading title-centered recovery-description" />
<ui:VisualElement class="auth-fields"><ui:Label text="Correo electrónico" class="field-label" /><ui:TextField name="email" label="" class="field auth-field" />
<ui:Button name="send" text="Enviar enlace" class="primary auth-submit" /></ui:VisualElement>
<ui:Label name="recovery-note" class="recovery-note" text="Revisá también tu carpeta de correo no deseado (spam)." />
<ui:Label name="status" class="status" />
</ui:VisualElement></ui:ScrollView></ui:VisualElement>
</ui:UXML>
