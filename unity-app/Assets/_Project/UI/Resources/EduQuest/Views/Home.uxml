<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../../USS/EduQuest.uss" />
  <ui:VisualElement class="screen home-mobile">
    <ui:VisualElement class="layout">
      <ui:ScrollView name="home-scroll" class="main-scroll">
        <ui:VisualElement class="content home-content">
          <ui:VisualElement class="home-topbar">
            <ui:VisualElement>
              <ui:Label text="EDUQUEST" class="eyebrow" />
              <ui:Label text="¡Tu próxima aventura!" class="heading" />
            </ui:VisualElement>
            <ui:Button name="home-menu" text="" tooltip="Abrir menú de navegación" class="home-menu" />
          </ui:VisualElement>
          <ui:VisualElement class="glass hero-card">
            <ui:VisualElement class="hero-info">
              <ui:VisualElement name="avatar" class="avatar hero-avatar" />
              <ui:Label name="student-name" text="Cargando alumno..." class="hero-name" />
              <ui:Label text="ALUMNO · AVENTURERO" class="hero-role" />
              <ui:Button name="edit-profile" text="EDITAR PERFIL" class="ghost profile-action" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="home-stats">
            <ui:VisualElement class="stat stat-card">
              <ui:VisualElement name="level-icon" class="stat-icon" />
              <ui:Label name="level" text="—" class="stat-number" />
              <ui:Label text="NIVEL" class="stat-label" />
            </ui:VisualElement>
            <ui:VisualElement class="stat stat-card">
              <ui:VisualElement name="points-icon" class="stat-icon" />
              <ui:Label name="points" text="—" class="stat-number" />
              <ui:Label text="PUNTOS" class="stat-label" />
            </ui:VisualElement>
            <ui:VisualElement class="stat stat-card">
              <ui:VisualElement name="coins-icon" class="stat-icon" />
              <ui:Label name="coins" text="—" class="stat-number" />
              <ui:Label text="MONEDAS" class="stat-label" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="glass missions-card">
            <ui:Label text="TU PROGRESO" class="eyebrow" />
            <ui:Label name="progress" class="text" text="Cargando misiones..." />
            <ui:Button name="go-practice" text="¡VAMOS A JUGAR!" class="primary" />
            <ui:Button name="go-subjects" text="VER MIS MATERIAS" class="secondary" />
          </ui:VisualElement>
          <ui:Label name="status" class="status" />
        </ui:VisualElement>
      </ui:ScrollView>
      <ui:VisualElement name="home-menu-layer" class="home-menu-layer">
        <ui:VisualElement name="menu-backdrop" class="home-menu-backdrop" />
      <ui:VisualElement class="sidebar">
        <ui:VisualElement class="drawer-header">
          <ui:Label text="EDUQUEST" class="brand" />
          <ui:Button name="close-menu" text="CERRAR ✕" class="drawer-close ghost" />
        </ui:VisualElement>
        <ui:Button name="nav-home" text="⌂   Inicio" class="nav" />
        <ui:Button name="nav-subjects" text="▤   Materias" class="nav" />
        <ui:Button name="nav-practice" text="▶   Jugar" class="nav" />
        <ui:Button name="nav-history" text="★   Historial" class="nav" />
        <ui:Button name="nav-profile" text="◉   Mi perfil" class="nav" />
        <ui:Button name="nav-logout" text="Cerrar sesión" class="danger logout" />
      </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
