<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../../USS/EduQuest.uss" />
<ui:VisualElement class="screen"><ui:ScrollView class="page-scroll"><ui:VisualElement class="container center"><ui:Label text="EDUQUEST" class="brand" /><ui:Label text="Creá tu cuenta de alumno" class="heading"/><ui:Label text="Seleccioná primero dónde estudiás. La institución deberá aprobar tu registro." class="subheading" /><ui:VisualElement class="glass form-wide"><ui:DropdownField name="institution" label="Institución" class="field" /><ui:DropdownField name="career" label="Carrera" class="field" /><ui:DropdownField name="course" label="Curso" class="field" /></ui:VisualElement><ui:VisualElement class="glass form-wide"><ui:VisualElement name="personal-form"><ui:TextField name="dni" label="DNI" class="field" /><ui:TextField name="first-name" label="Nombre" class="field" /><ui:TextField name="last-name" label="Apellido" class="field" /><ui:TextField name="email" label="Correo electrónico" class="field" /><ui:TextField name="phone" label="Teléfono (opcional)" class="field" /><ui:TextField name="password" label="Contraseña" class="field" /><ui:TextField name="confirm-password" label="Confirmar contraseña" class="field" /><ui:Button name="submit" text="Solicitar registro como alumno" class="primary" /></ui:VisualElement></ui:VisualElement><ui:Button name="back" text="Volver" class="ghost" /><ui:Label name="status" class="status" /></ui:VisualElement></ui:ScrollView></ui:VisualElement>
</ui:UXML>
