<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../../../USS/EduQuest.uss" />
<ui:VisualElement class="screen eq-theme generic-screen generic-profile"><ui:VisualElement class="layout"><ui:ScrollView class="main-scroll eq-scroll"><ui:VisualElement class="content generic-content"><ui:VisualElement class="home-topbar"><ui:Button name="home-menu" class="home-menu art-menu" tooltip="Abrir menú" /><ui:VisualElement class="logo-group small"><ui:VisualElement class="logo-star art-star" /><ui:VisualElement class="logo-text art-logo" /></ui:VisualElement><ui:VisualElement class="topbar-stat"><ui:VisualElement class="stat-symbol art-star" /><ui:Label name="top-points" class="top-stat-value" text="—" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="white-panel content-panel"><ui:Label xmlns:ui="UnityEngine.UIElements" text="Mi perfil" class="heading"/><ui:Label xmlns:ui="UnityEngine.UIElements" text="Actualizá tus datos personales y tu contraseña." class="subheading"/><ui:VisualElement class="glass eq-avatar-settings">
  <ui:Label text="Elegí tu avatar" class="question" />
  <ui:Label text="Podés cambiarlo cuando quieras." class="muted" />
  <ui:VisualElement class="eq-avatar-head">
    <ui:VisualElement name="profile-avatar-preview" class="eq-avatar-preview" />
    <ui:VisualElement class="eq-avatar-tabs">
      <ui:Button name="avatar-boys" text="Niños" class="eq-avatar-tab" />
      <ui:Button name="avatar-girls" text="Niñas" class="eq-avatar-tab" />
    </ui:VisualElement>
  </ui:VisualElement>
  <ui:VisualElement name="avatar-grid" class="eq-avatar-grid" />
  <ui:Button name="save-avatar" text="Guardar avatar" class="primary eq-avatar-save" />
</ui:VisualElement><ui:VisualElement xmlns:ui="UnityEngine.UIElements" class="glass"><ui:Label name="identity-info" text="Cargando..." class="muted"/><ui:TextField name="first-name" label="Nombre" class="field"/><ui:TextField name="last-name" label="Apellido" class="field"/><ui:TextField name="email" label="Correo electrónico" class="field"/><ui:TextField name="phone" label="Teléfono" class="field"/><ui:Button name="save" text="Guardar cambios" class="primary"/></ui:VisualElement><ui:VisualElement xmlns:ui="UnityEngine.UIElements" class="glass"><ui:Label text="Cambiar contraseña" class="question"/><ui:TextField name="current-password" label="Contraseña actual" class="field"/><ui:TextField name="new-password" label="Nueva contraseña" class="field"/><ui:TextField name="confirm-password" label="Confirmar nueva contraseña" class="field"/><ui:Button name="password-save" text="Cambiar contraseña" class="secondary"/></ui:VisualElement><ui:Label xmlns:ui="UnityEngine.UIElements" name="status" class="status"/></ui:VisualElement></ui:VisualElement></ui:ScrollView><ui:VisualElement name="home-menu-layer" class="home-menu-layer"><ui:VisualElement name="menu-backdrop" class="home-menu-backdrop" />
 <ui:VisualElement class="sidebar">
  <ui:VisualElement class="drawer-head"><ui:Button name="close-menu" class="drawer-close" text="✕" />
    <ui:VisualElement name="drawer-avatar" class="drawer-avatar art-avatar" />
    <ui:Label name="drawer-name" text="Estudiante" class="drawer-name" />
    <ui:Label name="drawer-level" text="Alumno de EduQuest" class="drawer-level" />
  </ui:VisualElement>
  <ui:Button name="nav-home" class="nav nav-active"><ui:VisualElement class="drawer-nav-icon art-navhome" /><ui:Label text="Inicio" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-practice" class="nav"><ui:VisualElement class="drawer-nav-icon art-navplay" /><ui:Label text="Jugar (Práctica)" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-subjects" class="nav"><ui:VisualElement class="drawer-nav-icon art-navsubjects" /><ui:Label text="Materias" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-history" class="nav"><ui:VisualElement class="drawer-nav-icon art-navhistory" /><ui:Label text="Historial" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-profile" class="nav"><ui:VisualElement class="drawer-nav-icon art-navprofile" /><ui:Label text="Perfil" class="drawer-nav-label" /></ui:Button>
  <ui:Button name="nav-settings" class="nav"><ui:VisualElement class="drawer-nav-icon art-navsettings" /><ui:Label text="Configuración" class="drawer-nav-label" /></ui:Button>
  <ui:VisualElement class="drawer-divider" />
  <ui:VisualElement class="drawer-spacer" />
  <ui:Button name="nav-logout" class="danger logout"><ui:VisualElement class="drawer-nav-icon art-navlogout" /><ui:Label text="Cerrar sesión" class="drawer-nav-label" /></ui:Button>
 </ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement>
</ui:UXML>
