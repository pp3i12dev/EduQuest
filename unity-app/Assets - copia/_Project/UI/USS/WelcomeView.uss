#welcome-container {
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    align-items: center; /* Para centrar los bloques horizontalmente */
    width: 100%;
    height: 100%;
}

#brand-block {
    margin-top: 80px;
    align-items: center;
}

#actions-block {
    margin-bottom: 40px;
    width: 80%; /* O un ancho fijo si preferís que los botones no ocupen todo el ancho */
    max-width: 400px;
}