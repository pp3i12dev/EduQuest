@import url("unity-theme://default");

.screen {
    flex: 1;
    justify-content: center;
    padding: 32px 24px;
    background-color: rgb(15, 23, 42);
}

.title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 16px;
    color: rgb(148, 163, 184);
    -unity-text-align: middle-center;
    margin-bottom: 32px;
}

.primary-button {
    height: 48px;
    border-radius: 8px;
    background-color: rgb(37, 99, 235);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    border-width: 0;
}

.secondary-button {
    height: 48px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 1px;
    border-color: rgb(71, 85, 105);
    color: rgb(226, 232, 240);
    font-size: 16px;
    margin-bottom: 12px;
}

.link-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(96, 165, 250);
    font-size: 14px;
    height: 30px;
}

.error-text {
    color: rgb(248, 113, 113);
    -unity-text-align: middle-center;
    margin-top: 8px;
    display: none;
}